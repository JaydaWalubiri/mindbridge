DJANGO_DEBUG=1
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Set these only when connecting a Turn.io number:
# TURN_WEBHOOK_SECRET=your-webhook-hmac-secret
# TURN_API_TOKEN=your-scoped-turn-api-token
# TURN_TEMPLATE_NAMESPACE=your-message-template-namespace
# TURN_CHECKIN_TEMPLATE_NAME=approved_checkin_template_name
# TURN_SESSION_TEMPLATE_NAME=approved_session_template_with_one_body_parameter
# TURN_TEMPLATE_LANGUAGE=en
# Production database:
# POSTGRES_DB=mindbridge
# POSTGRES_USER=mindbridge
# POSTGRES_PASSWORD=replace-me
# POSTGRES_HOST=localhost
# DJANGO_HTTPS_ONLY=1
# TURN_STAFF_TEMPLATE_NAME=approved_staff_notice_with_one_body_parameter
# TURN_SUPPORT_TEMPLATE_NAME=approved_support_template_without_parameters
# RISK_NEGATIVE_THRESHOLD=0.85
# Optional English DistilBERT baseline; download with check_sentiment --download first.
# SENTIMENT_ENABLED=1
# SENTIMENT_RISK_ENABLED=0
# SENTIMENT_MODEL=distilbert/distilbert-base-uncased-finetuned-sst-2-english
# SENTIMENT_REVISION=714eb0fa89d2f80546fda750413ed43d93601a13
# This app reads process environment variables; this example is not loaded automatically.
